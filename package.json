{
  "name": "peer-orchestra",
  "version": "0.3.0",
  "description": "Multi-agent orchestration for Claude Code \u2014 themed persona agents, structured dispatch protocol, and self-learning hooks via npx.",
  "main": "src/index.js",
  "bin": {
    "peer-orchestra": "src/index.js"
  },
  "files": [
    "src/",
    "templates/",
    "themes/",
    "commands/",
    "docs/quick-start.md",
    "docs/hooks-guide.md",
    "docs/agent-customization.md",
    "docs/theme-creation-guide.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/scaffold-test.js && node tests/extractor-test.js",
    "lint": "echo 'No lint configured yet'",
    "test:all": "node tests/scaffold-test.js; s=$?; node tests/extractor-test.js; e=$?; exit $((s||e))",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "claude-code",
    "multi-agent",
    "orchestration",
    "ai-team",
    "npx",
    "claude-peers"
  ],
  "author": "Varun Moka",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/varunmoka7/peer-orchestra.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": "https://github.com/varunmoka7/peer-orchestra#readme",
  "bugs": {
    "url": "https://github.com/varunmoka7/peer-orchestra/issues"
  }
}
